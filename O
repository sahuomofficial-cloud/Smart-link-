  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: #0b0c10;
    }
    .card-glow-green {
      box-shadow: 0 0 35px rgba(0, 214, 50, 0.75);
      border: 2px solid #00D632 !important;
      transform: translateY(-14px) rotate(-6deg) scale(1.05) !important;
      z-index: 50 !important;
    }
    .card-glow-blue {
      box-shadow: 0 0 35px rgba(0, 112, 186, 0.8);
      border: 2px solid #38bdf8 !important;
      transform: translateY(-14px) rotate(-2deg) scale(1.05) !important;
      z-index: 50 !important;
    }
    .card-glow-purple {
      box-shadow: 0 0 35px rgba(168, 85, 247, 0.8);
      border: 2px solid #c084fc !important;
      transform: translateY(-14px) rotate(2deg) scale(1.05) !important;
      z-index: 50 !important;
    }
    .card-glow-red {
      box-shadow: 0 0 35px rgba(244, 63, 94, 0.8);
      border: 2px solid #fb7185 !important;
      transform: translateY(-14px) rotate(6deg) scale(1.05) !important;
      z-index: 50 !important;
    }
    @keyframes subtlePulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.02); }
    }
    .pulse-btn {
      animation: subtlePulse 2.4s infinite ease-in-out;
    }
  </style>
</head>
<body class="bg-[#0b0c10] text-slate-100 antialiased min-h-screen flex flex-col justify-between selection:bg-amber-400 selection:text-black">

  <!-- BACKGROUND AMBIENT GLOW -->
